datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int      @id @default(autoincrement())
  username  String
  email     String   @unique
  password  String
  role      String
  createdAt DateTime @default(now())

  orders Order[]
}

model Product {
  id          Int     @id @default(autoincrement())
  name        String
  category    String
  type        String
  price       Int
  description String?

  orders Order[]
}

model Order {
  id         Int     @id @default(autoincrement())
  orderId    String  @unique
  userId     Int?
  productId  Int
  status     String
  totalPrice Int
  name       String?
  method     String?
  platform   String?
  version    String?
  gameUserId String?
  notes      String?

  createdAt DateTime @default(now())

  user    User?    @relation(fields: [userId], references: [id])
  product Product  @relation(fields: [productId], references: [id])
  payment Payment?

  gtaOrder GTAOrder?
}

model Payment {
  id         Int     @id @default(autoincrement())
  orderId    Int     @unique
  method     String
  status     String
  proof      String?
  gatewayRef String?

  order Order @relation(fields: [orderId], references: [id])
}

model GTAOrder {
  id            Int    @id @default(autoincrement())
  orderId       Int    @unique
  serviceType   String
  targetAccount String
  progress      Int

  order Order @relation(fields: [orderId], references: [id])
}
