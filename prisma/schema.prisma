datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  role      String   @default("user") // user / admin
  createdAt DateTime @default(now())

  orders Order[]
  passwordResetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Product {
  id          Int     @id @default(autoincrement())
  name        String
  category    String
  type        String
  price       Int
  description String?

  orders Order[]
}

model Order {
  id      Int    @id @default(autoincrement())
  orderId String @unique

  userId     Int
  productId  Int
  status     String @default("pending")
  totalPrice Int

  name       String?
  method     String?
  platform   String?
  version    String?
  gameUserId String?
  notes      String?

  discordChannelId String?

  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id])
  product Product  @relation(fields: [productId], references: [id])
  payment Payment?

  gtaOrder GTAOrder?
}

model Payment {
  id         Int     @id @default(autoincrement())
  orderId    Int     @unique
  method     String
  status     String
  proof      String?
  gatewayRef String?

  order Order @relation(fields: [orderId], references: [id])
}

model GTAOrder {
  id            Int    @id @default(autoincrement())
  orderId       Int    @unique
  serviceType   String
  targetAccount String
  progress      Int

  order Order @relation(fields: [orderId], references: [id])
}
