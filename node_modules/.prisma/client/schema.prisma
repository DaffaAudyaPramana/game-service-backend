datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int      @id @default(autoincrement())
  firstName String   @default("")
  lastName  String   @default("")
  email     String   @unique
  password  String
  role      String   @default("user") // user / admin
  points    Int      @default(0)
  createdAt DateTime @default(now())

  orders Order[]

  pointLedgers        PointLedger[]
  rewardRedemptions   RewardRedemption[]
  passwordResetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Product {
  id          Int     @id @default(autoincrement())
  name        String
  category    String
  type        String
  price       Int
  description String?

  orders Order[]
}

model Order {
  id      Int    @id @default(autoincrement())
  orderId String @unique

  userId     Int
  productId  Int
  status     String @default("pending")
  totalPrice Int

  name            String?
  method          String?
  platform        String?
  version         String?
  gameUserId      String?
  whatsapp        String?
  discordUsername String?
  notes           String?

  discordChannelId String?

  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id])
  product Product  @relation(fields: [productId], references: [id], onDelete: SetNull)
  payment Payment?

  gtaOrder GTAOrder?

  pointLedger PointLedger?
}

model Payment {
  id         Int     @id @default(autoincrement())
  orderId    Int     @unique
  method     String
  status     String
  proof      String?
  gatewayRef String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model GTAOrder {
  id            Int    @id @default(autoincrement())
  orderId       Int    @unique
  serviceType   String
  targetAccount String
  progress      Int

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

enum PointLedgerType {
  EARN
  REDEEM
  ADJUST
}

enum RedemptionStatus {
  pending
  approved
  rejected
  completed
}

model PointLedger {
  id           Int             @id @default(autoincrement())
  userId       Int
  orderId      Int?            @unique
  redemptionId Int?            @unique
  type         PointLedgerType
  points       Int
  description  String?
  balanceAfter Int
  createdAt    DateTime        @default(now())

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  order      Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  redemption RewardRedemption? @relation(fields: [redemptionId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model Reward {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  category    String   @default("voucher")
  pointsCost  Int
  sortOrder   Int      @default(999)
  stock       Int?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  redemptions RewardRedemption[]
}

model RewardRedemption {
  id         Int              @id @default(autoincrement())
  userId     Int
  rewardId   Int
  pointsCost Int
  status     RedemptionStatus @default(pending)
  notes      String?
  createdAt  DateTime         @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  reward Reward @relation(fields: [rewardId], references: [id], onDelete: Cascade)

  pointLedger PointLedger?

  @@index([userId])
  @@index([rewardId])
}

model Feedback {
  id               Int      @id @default(autoincrement())
  name             String
  email            String?
  category         String
  rating           Int
  message          String
  discordChannelId String?
  createdAt        DateTime @default(now())
}
